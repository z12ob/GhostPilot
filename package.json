{
  "name": "ghostpilot",
  "productName": "GhostPilot",
  "version": "1.1.1",
  "description": "Open-source desktop copilot for meetings, interviews, and coding with separate screen, microphone, and meeting-audio context.",
  "license": "MIT",
  "author": "Guram Melikidze",
  "homepage": "https://github.com/z12ob/GhostPilot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/z12ob/GhostPilot.git"
  },
  "bugs": {
    "url": "https://github.com/z12ob/GhostPilot/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "postinstall": "node node_modules/electron/install.js && node scripts/rename-electron.js",
    "prepare:whisper": "node scripts/prepare-whisper-runtime.js",
    "verify:whisper-runtime": "node scripts/verify-whisper-runtime.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win",
    "pack:win": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage --arm64"
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "windows",
    "cross-platform"
  ],
  "devDependencies": {
    "@electron-internal/extract-zip": "^1.0.1",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "resedit": "^3.0.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  }
}
